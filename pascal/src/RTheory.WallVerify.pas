unit RTheory.WallVerify;

{ Numeric probes for the wall (docs/WALL.md; registry: RTheory.Wall).

  Each probe re-checks a wall statement numerically at operator
  values from TOperatorPoint, using the Lie-closure engine of
  RTheory.LieVerify:

    TWallChain4Proof     the minimal overlapping-sl(2) chain for
                         sl(4) (the E106 pattern extended by one
                         block) spans rank 4 and closes at dim 10
                         of 15 -- the chain stalls (E108-E110)
    TWallWickProof       Wick-rotating the 8 cycle generators
                         closes at dim 28 (a unitary conjugate of
                         so(8)), not 63 (su(8)) -- Wick does not
                         commute with generation (WICKWALL). The
                         real-block form preserves real Lie
                         brackets, so the real dimension is the
                         algebra's own: 28, not twice it
    TWallCommutantProof  the sampled T_a family has a 1-dim
                         commutant in M_3(R) (scalars only), so no
                         complex structure commutes with the
                         sampled family -- the sl(3)-sized probe
                         of WALL-CPLX

  These are CHECKED-strength numeric confirmations of statements
  whose scope labels are carried verbatim from the registry. A
  PASS here never upgrades any scope label. }

{$mode objfpc}{$H+}

interface

uses
  SysUtils, Math, RTheory.Types, RTheory.Operators, RTheory.Theorems,
  RTheory.LieVerify;

type
  TWallChain4Proof = class(TProofObject)
  public
    constructor Create; reintroduce;
    function VerifyNumeric(out ADetail: string): Boolean; override;
  end;

  TWallWickProof = class(TProofObject)
  public
    constructor Create; reintroduce;
    function VerifyNumeric(out ADetail: string): Boolean; override;
  end;

  TWallCommutantProof = class(TProofObject)
  public
    constructor Create; reintroduce;
    function VerifyNumeric(out ADetail: string): Boolean; override;
  end;

{ Dimension of the commutant [X in M_n(R) : [X, M] = 0 for every
  M in AMats], by row reduction of the linear system in the entries
  of X. }
function CommutantDim(const AMats: array of TDynMatrix; AN: Integer): Integer;

implementation

{ --- the minimal chain, one size up (E108) --- }

function Chain4At(AX: Double): TDynMatrix;
var
  P: TOperatorPoint;
begin
  P := TOperatorPoint.Create(AX);
  try
    Result := ZeroMatrix(4);
    Result[0][1] := P.Srx;
    Result[1][0] := P.Cxp;  Result[1][2] := P.Crx;
    Result[2][1] := P.Sxp;  Result[2][3] := P.Srx;
    Result[3][2] := P.Cxp;
  finally
    P.Free;
  end;
end;

constructor TWallChain4Proof.Create;
begin
  inherited Create('WALL-CHAIN4',
    'Minimal overlapping-sl(2) chain for sl(4) (E106 pattern extended by one block): samples span rank 4, Lie closure dim 10 of 15 -- the chain stalls',
    psProved, 'dependency graph E108-E110');
  ScopeLabel := 'PROVED for the sampled minimal chain only; NOT a general sl(n) wall';
end;

function TWallChain4Proof.VerifyNumeric(out ADetail: string): Boolean;
var
  Samples: array of TDynMatrix;
  Basis: TSpanBasis;
  SD, CD, K: Integer;
begin
  SetLength(Samples, 4);
  for K := 0 to 3 do
    Samples[K] := Chain4At((2 * K + 1) * Pi / 8.0);
  SD := SpanDim(Samples, 4);
  CD := LieClosureDim(Samples, 4, Basis);
  Basis.Free;
  ADetail := Format('sample span %d (expect 4), closure dim %d (expect 10 of 15 -- the stall)',
    [SD, CD]);
  Result := (SD = 4) and (CD = 10);
end;

{ --- Wick on the cycle generators (WICKWALL) --- }

{ A complex matrix U + i*V as the real block matrix [[U,-V],[V,U]].
  The block map is an injective real-algebra homomorphism, so the
  real Lie algebra generated by the blocks is isomorphic to the
  real Lie algebra generated by the complex matrices themselves. }
function ComplexBlock(const U, V: TDynMatrix): TDynMatrix;
var
  N, I, J: Integer;
begin
  N := Length(U);
  Result := ZeroMatrix(2 * N);
  for I := 0 to N - 1 do
    for J := 0 to N - 1 do
    begin
      Result[I][J] := U[I][J];
      Result[I][J + N] := -V[I][J];
      Result[I + N][J] := V[I][J];
      Result[I + N][J + N] := U[I][J];
    end;
end;

constructor TWallWickProof.Create;
begin
  inherited Create('WALL-WICK',
    'Wick-rotating the 8 cycle generators: closure dim 28 (unitary conjugate of so(8)), NOT 63 (su(8)). Wick does not commute with generation',
    psProved, 'proofs/wick_sl8_wall.md');
  ScopeLabel := 'PROVED (conjugacy identity) / CHECKED (dim-28 closure, compactness)';
end;

function TWallWickProof.VerifyNumeric(out ADetail: string): Boolean;
var
  Vals: array[0..7] of Double;
  Gens: array of TDynMatrix;
  Basis: TSpanBasis;
  P: TOperatorPoint;
  A, S: TDynMatrix;
  D, I: Integer;
begin
  P := TOperatorPoint.Create(Pi / 8.0);
  try
    Vals[0] := P.Srx;  Vals[1] := P.Sxp;
    Vals[2] := P.Cxp;  Vals[3] := P.Crx;
    Vals[4] := P.Urx;  Vals[5] := P.SawUp;
    Vals[6] := P.Uxp;  Vals[7] := P.SawDown;
  finally
    P.Free;
  end;
  SetLength(Gens, 8);
  for I := 0 to 7 do
  begin
    { X = Vals[I] * E at (i, i+1 mod 8); Wick generator = A + i*S
      with A = (X - X^T)/2 (antisymmetric, stays), S = (X + X^T)/2
      (symmetric, rotated). }
    A := ZeroMatrix(8);
    S := ZeroMatrix(8);
    A[I][(I + 1) mod 8] := Vals[I] / 2.0;
    A[(I + 1) mod 8][I] := -Vals[I] / 2.0;
    S[I][(I + 1) mod 8] := Vals[I] / 2.0;
    S[(I + 1) mod 8][I] := Vals[I] / 2.0;
    Gens[I] := ComplexBlock(A, S);
  end;
  D := LieClosureDim(Gens, 16, Basis);
  Basis.Free;
  ADetail := Format('Wick-rotated cycle generators: closure dim %d (expect 28, so(8) conjugate; su(8) would give 63)',
    [D]);
  Result := (D = 28);
end;

{ --- commutant of the sampled T_a family (probe of WALL-CPLX) --- }

{ The T_a matrix, mirroring RTheory.LieVerify's TMatrixAt:
  [[urx, srx, 0], [cxp, -urx, uxp], [0, -uxp, 0]]. }
function TafAt(AX: Double): TDynMatrix;
var
  P: TOperatorPoint;
begin
  P := TOperatorPoint.Create(AX);
  try
    Result := ZeroMatrix(3);
    Result[0][0] := P.Urx;   Result[0][1] := P.Srx;
    Result[1][0] := P.Cxp;   Result[1][1] := -P.Urx; Result[1][2] := P.Uxp;
    Result[2][1] := -P.Uxp;
  finally
    P.Free;
  end;
end;

function CommutantDim(const AMats: array of TDynMatrix; AN: Integer): Integer;
var
  Cols, Rows, R, C, I, J, K, P, Q, Rank, PivRow: Integer;
  Eq: array of TDynVector;
  MaxEntry, Best, F: Double;
  RowTmp: TDynVector;
begin
  Cols := AN * AN;
  Rows := (High(AMats) + 1) * Cols;
  SetLength(Eq, Rows);
  for I := 0 to Rows - 1 do
    SetLength(Eq[I], Cols);
  MaxEntry := 0.0;
  { Equation (K, I, J): the (I,J) entry of [X, M_K] is 0, i.e.
      sum_P X[I,P] * M_K[P,J] - sum_P M_K[I,P] * X[P,J] = 0.
    Coefficient of the unknown X[P,Q]:
      delta(I,Q) * M_K[P,J] - delta(J,Q) * M_K[I,P]. }
  for K := 0 to High(AMats) do
    for I := 0 to AN - 1 do
      for J := 0 to AN - 1 do
      begin
        R := (K * AN + I) * AN + J;
        for P := 0 to AN - 1 do
          for Q := 0 to AN - 1 do
          begin
            F := 0.0;
            if Q = I then
              F := F + AMats[K][P][J];
            if Q = J then
              F := F - AMats[K][I][P];
            Eq[R][P * AN + Q] := F;
            if Abs(F) > MaxEntry then
              MaxEntry := Abs(F);
          end;
      end;
  { Rank by forward elimination with partial pivoting. }
  Rank := 0;
  for C := 0 to Cols - 1 do
  begin
    PivRow := -1;
    Best := MaxEntry * 1e-9;
    for R := Rank to Rows - 1 do
      if Abs(Eq[R][C]) > Best then
      begin
        Best := Abs(Eq[R][C]);
        PivRow := R;
      end;
    if PivRow < 0 then
      Continue;
    RowTmp := Eq[Rank];
    Eq[Rank] := Eq[PivRow];
    Eq[PivRow] := RowTmp;
    for R := Rank + 1 to Rows - 1 do
    begin
      F := Eq[R][C] / Eq[Rank][C];
      if F <> 0.0 then
        for J := C to Cols - 1 do
          Eq[R][J] := Eq[R][J] - F * Eq[Rank][J];
    end;
    Inc(Rank);
    if Rank = Rows then
      Break;
  end;
  Result := Cols - Rank;
end;

constructor TWallCommutantProof.Create;
begin
  inherited Create('WALL-COMMUTANT',
    'Probe of WALL-CPLX on the sl(3) family: the commutant of the sampled T_a(x) in M_3(R) is the scalars (dim 1), so no complex structure commutes with the sampled family -- a commuting J with J^2 = -I would have to live in the commutant',
    psChecked, 'numeric probe (this unit); cf. E70-E72 irreducibility');
end;

function TWallCommutantProof.VerifyNumeric(out ADetail: string): Boolean;
var
  Samples: array of TDynMatrix;
  CD, K: Integer;
begin
  SetLength(Samples, 4);
  for K := 0 to 3 do
    Samples[K] := TafAt((2 * K + 1) * Pi / 8.0);
  CD := CommutantDim(Samples, 3);
  ADetail := Format('commutant dim %d (expect 1 = scalars only; no commuting J with J^2 = -I)',
    [CD]);
  Result := (CD = 1);
end;

end.
